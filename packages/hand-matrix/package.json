{
  "name": "@spotlab/hand-matrix",
  "version": "0.4.0",
  "description": "A 13x13 poker hand-matrix React component: the read-only grid primitive and a range-string-aware display component, themed through CSS custom properties.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mAAdhaTTah/spotlab",
    "directory": "packages/hand-matrix"
  },
  "homepage": "https://github.com/mAAdhaTTah/spotlab/tree/main/packages/hand-matrix#readme",
  "bugs": {
    "url": "https://github.com/mAAdhaTTah/spotlab/issues"
  },
  "author": "James DiGioia",
  "keywords": [
    "poker",
    "range",
    "hand-matrix",
    "react",
    "component",
    "texas-holdem"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/hand-matrix.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@spotlab/range": "workspace:^0.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "scripts": {
    "prepublishOnly": "node -e \"if(!require('node:fs').existsSync('dist/index.js')){console.error('dist/ is missing: run pnpm build before publishing');process.exit(1)}\"",
    "typecheck": "tsc -p tsconfig.json",
    "build:vite": "vite build",
    "build:css": "node scripts/copy-css.mjs",
    "build": "pnpm typecheck && pnpm build:vite && pnpm build:css",
    "test": "vitest run --project unit",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "test-storybook": "NODE_ENV=production vitest run --project storybook"
  },
  "devDependencies": {
    "@spotlab/range": "workspace:*",
    "@storybook/addon-vitest": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "playwright": "^1.49.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "storybook": "^10.5.5",
    "typescript": "^6.0.0",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
