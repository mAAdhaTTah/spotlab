{
  "name": "@spotlab/range",
  "version": "0.1.0",
  "description": "A poker range-string parser and serializer, compiled from Rust to wasm: combo/hand grammar, canonical hand tokens, and weighted-range arithmetic.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mAAdhaTTah/spotlab",
    "directory": "packages/range"
  },
  "homepage": "https://github.com/mAAdhaTTah/spotlab/tree/main/packages/range#readme",
  "bugs": {
    "url": "https://github.com/mAAdhaTTah/spotlab/issues"
  },
  "author": "James DiGioia",
  "keywords": [
    "poker",
    "range",
    "parser",
    "wasm",
    "texas-holdem"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build ../../crates/spotlab-range-wasm --release --target web --out-name range --out-dir ../../packages/range/src/wasm",
    "build:inline": "node scripts/inline-wasm.mjs",
    "build:strip-wasm-url-fallback": "node scripts/strip-wasm-url-fallback.mjs",
    "build:vite": "vite build",
    "build:size": "node scripts/check-size.mjs",
    "build": "pnpm build:wasm && pnpm build:inline && pnpm build:strip-wasm-url-fallback && pnpm typecheck && pnpm build:vite && pnpm build:size",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^7.0.0",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^4.1.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
