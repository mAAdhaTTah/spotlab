{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate Dashboard",
  "configMigration": true,
  "prHourlyLimit": 0,
  "minimumReleaseAge": "3 days",
  "gitIgnoredAuthors": [
    "41898283+github-actions[bot]@users.noreply.github.com"
  ],
  "packageRules": [
    {
      "groupName": "specta packages",
      "matchDepNames": ["specta", "specta-typescript"],
      "matchManagers": ["cargo"]
    },
    {
      "matchManagers": ["github-actions"],
      "matchDepNames": [
        "bruits/sampo",
        "bruits/sampo/crates/sampo-github-action"
      ],
      "versioning": "regex:^cargo-sampo-github-action-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "description": "The Sampo CLI must match the sampo-core bundled by the release action; see RELEASING.md",
      "groupName": "Sampo",
      "matchDepNames": [
        "sampo",
        "bruits/sampo",
        "bruits/sampo/crates/sampo-github-action"
      ],
      "matchManagers": ["npm", "github-actions"]
    }
  ]
}
