{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate Dashboard",
  "configMigration": true,
  "prHourlyLimit": 0,
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "groupName": "specta packages",
      "matchDepNames": ["specta", "specta-typescript"],
      "matchManagers": ["cargo"]
    },
    {
      "matchManagers": ["github-actions"],
      "matchDepNames": [
        "bruits/sampo",
        "bruits/sampo/crates/sampo-github-action"
      ],
      "versioning": "regex:^cargo-sampo-github-action-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    }
  ]
}
